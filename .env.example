# Tout est facultatif : Repère démarre sans fichier .env.
# Complément d'extraction par Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Recherche d'adresse automatique après chaque capture (1 = oui, 0 = non).
ADEME_AUTO_SEARCH=1
# Mises à jour : dépôt et branche lus au démarrage du conteneur. Pour figer une version, indiquer un commit
# (ex. REPERE_GITHUB_REF=540dae2323442075ec7d76357afc3e6a13e259cd) ; vide = dernière version validée.
REPERE_GITHUB_REF=
# Seulement si le dépôt devient privé : jeton GitHub « fine-grained », Contents en lecture seule sur ce dépôt.
REPERE_GITHUB_TOKEN=
