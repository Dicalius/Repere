# Tout est facultatif : Repère démarre sans fichier .env.
# Complément d'extraction par Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Recherche d'adresse automatique après chaque capture (1 = oui, 0 = non).
ADEME_AUTO_SEARCH=1
# Image de l'application : vide = latest (dernier push sur main). Pour revenir à une image précise, indiquer le
# SHA complet d'un commit qui a déclenché le workflow « Image Repère » (onglet Actions), puis
# docker compose pull app et docker compose up -d --no-deps app.
REPERE_TAG=
