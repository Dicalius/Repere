# Copié automatiquement en .env par INITIALISER.ps1 / demarrer.sh avec un mot de passe aléatoire.
POSTGRES_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Version de l'application à utiliser (latest par défaut). Ex. REPERE_VERSION=1.3.0 pour revenir en arrière.
REPERE_VERSION=latest
# Recherche d'adresse automatique après chaque capture (1 = oui, 0 = non).
ADEME_AUTO_SEARCH=1
