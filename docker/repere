#!/bin/sh
# Commandes Repère dans le conteneur : docker compose exec app repere <commande>
#   repere token                         code de connexion de l'application et de l'extension
#   repere version                       version et commit de l'image
#   repere dpe …, repere dpe-lettres …   vérifications de la recherche d'adresse (voir app/manage.py)
cd /app && exec python -m app.manage "$@"
